# ========================================================
# JARVIS LITE — ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# ========================================================

# Server Configuration
JARVIS_HOST=127.0.0.1
JARVIS_PORT=8001
JARVIS_LOG_LEVEL=INFO

# Security & Secrets
# Note: Primary API tokens are securely managed via Windows Keyring
# JARVIS_API_KEY=optional_fallback_token

# Google Workspace Integration (Optional)
GOOGLE_CREDENTIALS_PATH=credentials/google_credentials.json

# Secondary External Model Server (Optional Fallback)
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
